# Copy to .env for local development. Never commit the real .env.

# Any long random string. Generate one with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Leave unset locally to use instance/designplus.sqlite3.
# On Render this is supplied automatically by the Postgres add-on.
# On Vercel, use your Supabase *pooler* connection string (port 6543),
# not the direct one — serverless functions need pooled connections.
# DATABASE_URL=postgresql+psycopg://user:pass@host/dbname

# Public origin, used for canonical URLs, og:url and sitemap.xml.
SITE_URL=http://localhost:5000

# Required on Vercel (leave unset locally): uploaded images are stored in a
# public Supabase Storage bucket instead of on local disk, since Vercel's
# filesystem is read-only. Find these under Project Settings > API in Supabase.
# SUPABASE_URL=https://xxxxxxxx.supabase.co
# SUPABASE_SERVICE_KEY=service-role-key
# SUPABASE_STORAGE_BUCKET=uploads

# The first admin account, created by `flask seed` if no users exist.
ADMIN_EMAIL=work.designplus@gmail.com
ADMIN_PASSWORD=change-me-before-deploying

# Optional: email enquiry notifications. Without these the enquiry is still
# saved to the database and visible in the admin inbox.
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASSWORD=
# NOTIFY_EMAIL=work.designplus@gmail.com
